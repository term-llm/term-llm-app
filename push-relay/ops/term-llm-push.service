[Unit]
Description=term-llm native APNs push relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=term-llm-push
Group=term-llm-push
WorkingDirectory=/opt/term-llm-push/current
ExecStart=/opt/term-llm-push/current/term-llm-push
Environment=RELAY_ADDR=127.0.0.1:8768
Environment=APNS_KEY_ID=6Q6W284ZY6
Environment=APNS_TEAM_ID=B6BAJ46A72
Environment=APNS_TOPIC=com.termllm.app
# This host exposes LoadCredential files as root:root 0440. Stage owner-only
# copies in a private tmpfs runtime directory to satisfy strict file validation.
RuntimeDirectory=term-llm-push
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -m 0400 %d/apns-key.p8 /run/term-llm-push/apns-key.p8
ExecStartPre=/usr/bin/install -m 0400 %d/relay-token /run/term-llm-push/relay-token
Environment=APNS_KEY_FILE=/run/term-llm-push/apns-key.p8
Environment=RELAY_TOKEN_FILE=/run/term-llm-push/relay-token
LoadCredential=apns-key.p8:/etc/term-llm-push/apns-key.p8
LoadCredential=relay-token:/etc/term-llm-push/relay-token
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=256
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
